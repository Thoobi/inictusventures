{
  "name": "inistic-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typegen": "sanity schemas extract --force --enforce-required-fields && sanity typegen generate",
    "migrate:extract": "node --env-file=../.env migration/scripts/extract.mjs",
    "migrate:import": "sanity exec migration/scripts/import.ts --with-user-token",
    "migrate:import:write": "sanity exec migration/scripts/import.ts --with-user-token -- --write",
    "migrate:validate": "sanity exec migration/scripts/validate.ts --with-user-token"
  },
  "dependencies": {
    "@portabletext/block-tools": "^6.0.5",
    "@sanity/icons": "^5.2.3",
    "@sanity/schema": "^6.20.0",
    "@sanity/vision": "^6.20.0",
    "jsdom": "^30.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanity": "^6.20.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "typescript": "^5.9.3"
  }
}
